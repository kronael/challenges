# Go solver directories contain source and harness files only. This also catches
# extensionless executables written by a plain `go build`.
/*/go/*
!/*/go/*.go
!/*/go/go.mod
!/*/go/go.sum
!/*/go/Makefile
!/*/go/.gitignore

# Rust
target/
Cargo.lock

# Benchmark artefacts
*.prof
*.trace
perf.data
/*/cases/??_large_*.in
/*/cases/??_large_*.out

# Compiled C binaries (golden/rotten build to ./main; c/ builds these)
*/golden/main
*/rotten/main
*/c/main
*/c/run_tests
*/c/stress
*/c/benchmark
